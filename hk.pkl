amends "package://github.com/jdx/hk/releases/download/v1.45.0/hk@1.45.0#/Config.pkl"

local seedChecks = new Mapping<String, Step> {
  ["format"] {
    check = "dprint check"
    fix = "dprint fmt"
  }

  ["secret-scan"] {
    check = "infisical scan --no-git --redact --no-color"
  }

  ["no-env-files"] {
    check = "! git ls-files --others --cached --exclude-standard | grep -E '(^|/)\\.env($|\\.)'"
  }

  ["no-github-actions-or-issues"] {
    check = "! git ls-files --others --cached --exclude-standard | grep -E '^\\.github/(workflows|ISSUE_TEMPLATE)/'"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    steps = seedChecks
  }

  ["pre-push"] {
    steps = seedChecks
  }

  ["check"] {
    steps = seedChecks
  }
}
